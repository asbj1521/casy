            "endDate": "2026-11-19",
            "startTime": "",
            "endTime": ""
          }
        ]
      }
    },
    {
      "name": "all of a month at the parents",
      "lang": "da",
      "text": "Jeg er hjemme hos mine forældre hele december",
      "expect": {
        "count": 1,
        "entries": [
          {
            "kind": "away",
            "startDate": "2026-12-01",
            "endDate": "2026-12-31",
            "startTime": "",
            "endTime": ""
          }
        ]
      }
    },
    {
      "name": "next week, in English",
      "lang": "en",
      "text": "I'm away next week",
      "expect": {
        "count": 1,
        "entries": [
          {
            "kind": "away",
            "startDate": "2026-10-12",
            "endDate": { "oneOf": ["2026-10-16", "2026-10-18"] }
          }
        ]
      }
    },
    {
      "name": "a course on a weekday evening",
