      "current": [
        {
          "kind": "away",
          "label": "Rejse",
          "startDate": "2026-11-12",
          "startTime": "",
          "endDate": "2026-11-19",
          "endTime": ""
        }
      ],
      "expect": {
        "count": 1,
        "entries": [{ "kind": "away", "startDate": "2026-11-12", "endDate": "2026-11-21" }]
      }
    },
    {
      "name": "more details add an entry and keep the old one",
      "lang": "en",
      "text": "Also a dentist appointment on 3 November from 14:00 to 15:00",
      "earlier": ["I'm away 12 to 19 November"],
      "current": [
        {
          "kind": "away",
          "label": "Trip",
          "startDate": "2026-11-12",
          "startTime": "",
          "endDate": "2026-11-19",
          "endTime": ""
        }
      ],
      "expect": {
        "count": 2,
        "entries": [
          { "kind": "busy", "startDate": "2026-11-03", "startTime": "14:00", "endTime": "15:00" },
          { "kind": "away", "startDate": "2026-11-12", "endDate": "2026-11-19" }
        ]
      }
    }
  ]
