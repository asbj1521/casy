        "count": 1,
        "entries": [
          { "kind": "busy", "startDate": "2026-10-15", "startTime": "18:00", "endTime": "21:00" }
        ]
      }
    },
    {
      "name": "a day with no end date is a single day",
      "lang": "da",
      "text": "Jeg er til bryllup lørdag den 24. oktober, hele dagen",
      "expect": {
        "count": 1,
        "entries": [
          {
            "kind": "busy",
            "startDate": "2026-10-24",
            "endDate": { "oneOf": ["", "2026-10-24"] },
            "startTime": "",
            "endTime": ""
          }
        ]
      }
    },
    {
      "name": "something that repeats becomes one entry for each time",
      "lang": "da",
      "text": "Jeg har fodbold hver torsdag aften fra 18 til 20 i november",
      "expect": {
        "count": 4,
        "entries": [
          { "kind": "busy", "startDate": "2026-11-05", "startTime": "18:00", "endTime": "20:00" },
          { "kind": "busy", "startDate": "2026-11-12" },
          { "kind": "busy", "startDate": "2026-11-19" },
          { "kind": "busy", "startDate": "2026-11-26" }
        ]
      }
    },
    {
      "name": "no dates at all asks when",
      "lang": "da",
      "text": "Jeg er væk i nogle dage",
      "expect": { "count": 0, "message": "some" }
    },
    {
      "name": "being free is not something Casy can note yet",
      "lang": "en",
      "text": "I can do Fridays in November even though work is booked",
      "expect": { "count": 0, "message": "some" }
    },
    {
      "name": "the past is no entry",
      "lang": "da",
      "text": "Jeg var på ferie i august",
      "expect": { "count": 0 }
    },
    {
      "name": "text that isn't about time",
      "lang": "da",
      "text": "Jeg elsker pizza med ananas",
      "expect": { "count": 0, "message": "none" }
    },
    {
      "name": "dictation with a misheard number",
      "lang": "da",
      "text": "øh jeg skal altså være i København fra den tolvte til den, nej, den femtende november",
      "expect": {
        "count": 1,
