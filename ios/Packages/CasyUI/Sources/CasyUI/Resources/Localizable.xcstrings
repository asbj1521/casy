{
  "sourceLanguage": "da",
  "strings": {
    "admin.pageFree": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Uden side"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without the page"
          }
        }
      }
    },
    "admin.pageFreeDetail": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen logger selv ind og åbner ikke websiden. Den lukker, når du skifter, så åbn den igen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app signs in itself and doesn't open the website. It closes when you switch, so open it again."
          }
        }
      }
    },
    "authErrors.appleTaken": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det Apple-id hører allerede til en anden konto."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That Apple ID already belongs to another account."
          }
        }
      }
    },
    "authErrors.codeInvalid": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Koden er forkert eller udløbet. Tjek mailen, eller få en ny kode."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That code is wrong or has expired. Check the email, or get a new code."
          }
        }
      }
    },
    "authErrors.emailNotConfirmed": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekræft din e-mail først. Tjek din indbakke."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm your email first. Check your inbox."
          }
        }
      }
    },
