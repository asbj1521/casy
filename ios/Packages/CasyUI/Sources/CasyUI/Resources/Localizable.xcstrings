    "admin.deleteUserConfirm": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slet %1$@s konto? Det fjerner personens %2$@ og alle optagede tidsrum, vi har gemt for personen. Grupper med andre medlemmer fortsætter uden personen. Det kan ikke fortrydes, og det er ikke en udelukkelse: personen kan oprette sig igen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete %1$@'s account? This removes their %2$@, along with every busy time we stored for them. Groups other people are in carry on without them. This can't be undone, and it isn't a ban: they can sign up again."
          }
        }
      }
    },
