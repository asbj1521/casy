      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slet \"%@\"? Alle 1 medlem mister den med det samme, sammen med dens invitationslinks. Det kan ikke fortrydes."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete \"%@\"? All 1 member lose it right away, along with its invite links. This can't be undone."
          }
        }
      }
    },
    "admin.deleteGroupConfirm.many": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slet \"%1$@\"? Alle %2$d medlemmer mister den med det samme, sammen med dens invitationslinks. Det kan ikke fortrydes."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete \"%1$@\"? All %2$d members lose it right away, along with its invite links. This can't be undone."
          }
        }
      }
    },
    "admin.removeMember": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjern %1$@ fra \"%2$@\"? Personen skal have et nyt invitationslink for at komme ind igen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove %1$@ from \"%2$@\"? They'll need a new invite link to get back in."
