    "icsForm.aboutBody": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle med linket kan læse kalenderen. Det gemmes privat og vises aldrig igen. Kun start- og sluttider gemmes. Titler, steder og deltagere fjernes, før noget gemmes."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anyone who has this link can read the calendar. It is stored privately and never shown again. Only start and end times are kept; titles, places and attendees are removed before anything is stored."
          }
        }
      }
    },
