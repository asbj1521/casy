    "invitations.privacy": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Medlemmer kan se hinandens navne, og hvornår de er optaget, så vi kan finde et tidspunkt, der passer alle. Ingen kan se din e-mailadresse, navnene på dine kalendere eller hvad dine aftaler hedder."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Members can see each other's name and when they are busy, so we can find a time that works for everyone. Nobody sees your email address, your calendars' names, or what any of your events are called."
          }
        }
      }
    },
    "invitations.title": {
