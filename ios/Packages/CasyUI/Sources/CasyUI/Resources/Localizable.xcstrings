    "appleForm.aboutBody": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple har ingen login med ét klik til kalendere. Gå til Login og sikkerhed på account.apple.com, åbn App-specifikke adgangskoder, og opret en til Vi finder lige en dag. Vi ser aldrig adgangskoden til din Apple-konto. Vi spørger kun Apple om tidspunkter, aldrig titler, og gemmer adgangskoden krypteret. Du kan tilbagekalde den når som helst samme sted."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple has no one-click sign-in for calendars. In Sign-In and Security at account.apple.com, open App-Specific Passwords and create one for We'll find a day. We never see your main Apple Account password. We only ask Apple for event times, never titles, and store this password encrypted. You can revoke it at any time in the same place."
          }
        }
      }
    },
