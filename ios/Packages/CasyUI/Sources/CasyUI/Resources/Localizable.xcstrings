    "calendarTour.levelsHelp": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lav prioritet: vi må lægge aftaler oven i den, hvis ingen dato inden for en uge passer uden. Normal prioritet: optaget, men til ture og ferier kan du tage fri fra arbejde og skole. Høj prioritet: optaget, også når der planlægges ture."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Low priority: we may put events on top of it if no date within a week works without. Normal priority: busy, but for trips and holidays you can take time off work and school. High priority: busy, also when trips are being planned."
          }
        }
      }
    },
