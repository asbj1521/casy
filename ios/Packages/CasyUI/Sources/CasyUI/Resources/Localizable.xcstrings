    "report.blockHelp": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kan ikke invitere dig til flere grupper. I er stadig i de grupper, I deler, til en af jer forlader dem."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ can't invite you to any more groups. You stay in the groups you share until one of you leaves."
          }
        }
      }
    },
