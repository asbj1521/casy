    "primaryCalendar.introShort": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Her lægger vi de aftaler, I bliver enige om."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where we put the events you agree on."
          }
        }
      }
    },
    "primaryCalendar.autoAddShort": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når alle har sagt ja"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once everyone has said yes"
          }
        }
      }
    },
    "primaryCalendar.noWritable": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forbind en Apple-kalender ovenfor, eller din telefon i appen, så kan vi lægge jeres aftaler direkte i den."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect an Apple calendar above, or your phone in the app, and we can add your agreed events straight to it."
          }
        }
      }
    },
    "primaryCalendar.waitingForSync": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi tjekker, hvilke af dine Apple-kalendere vi må lægge aftaler i. Tryk Synkronisér nu, eller vent op til en time."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We're checking which of your Apple calendars we may add events to. Press Sync now, or wait up to an hour."
          }
        }
      }
    },
    "primaryCalendar.selectLabel": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
