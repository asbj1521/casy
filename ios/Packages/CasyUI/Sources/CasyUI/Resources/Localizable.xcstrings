      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "AI slås fra, og de mærkater, der er gemt på denne telefon, og det, du har delt om vigtige aftaler og dine sendte rettelser, slettes."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI is turned off, and the labels kept on this phone and what you shared about important events and your sent corrections are deleted."
          }
        }
      }
    },
