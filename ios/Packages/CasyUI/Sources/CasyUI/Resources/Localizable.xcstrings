    "providerCard.removeIcs": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjern %@? De synkroniserede optagede tidsrum og det gemte link slettes hos os. Selve linket virker stadig hos kilden, indtil du laver et nyt der."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove %@? Its synced busy times and the saved link are deleted on our side. The link itself stays valid at its source until you regenerate it there."
          }
        }
      }
    },
    "providerCard.removeIcs.none": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjern dette link? De synkroniserede optagede tidsrum og det gemte link slettes hos os. Selve linket virker stadig hos kilden, indtil du laver et nyt der."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove this link? Its synced busy times and the saved link are deleted on our side. The link itself stays valid at its source until you regenerate it there."
          }
        }
      }
    },
    "providerCard.removeApple": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjern %@? De synkroniserede optagede tidsrum og den gemte adgangskode slettes hos os. For også at tilbagekalde selve adgangskoden skal du slette den under App-specifikke adgangskoder på account.apple.com/account/manage."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove %@? Its synced busy times and the saved password are deleted on our side. To also revoke the password itself, delete it under App-Specific Passwords at account.apple.com/account/manage."
          }
        }
      }
    },
    "providerCard.removeApple.none": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjern denne konto? De synkroniserede optagede tidsrum og den gemte adgangskode slettes hos os. For også at tilbagekalde selve adgangskoden skal du slette den under App-specifikke adgangskoder på account.apple.com/account/manage."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove this account? Its synced busy times and the saved password are deleted on our side. To also revoke the password itself, delete it under App-Specific Passwords at account.apple.com/account/manage."
          }
        }
      }
    },
    "providerCard.removeDevice": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjern %@? De optagede tidsrum fra telefonen slettes hos os, og appen holder op med at sende dem. Appens adgang til kalenderen kan også slås fra under Find en dag i telefonens Indstillinger."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove %@? The busy times from the phone are deleted on our side, and the app stops sending them. The app's calendar access can also be turned off under Find a day in the phone's Settings."
          }
        }
      }
    },
    "providerCard.removeDevice.none": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjern denne telefon? De optagede tidsrum fra telefonen slettes hos os, og appen holder op med at sende dem. Appens adgang til kalenderen kan også slås fra under Find en dag i telefonens Indstillinger."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove this phone? The busy times from the phone are deleted on our side, and the app stops sending them. The app's calendar access can also be turned off under Find a day in the phone's Settings."
          }
        }
      }
    },
    "providerCard.removeOauth": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjern %1$@? De synkroniserede optagede tidsrum slettes hos os. For også at fjerne vores adgang skal du fjerne Vi finder lige en dag under forbundne apps i din konto hos %2$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove %1$@? Its synced busy times are deleted on our side. To also revoke our access, remove We'll find a day in that account's connected-apps settings at %2$@."
          }
        }
      }
    },
    "providerCard.removeOauth.none": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjern denne konto? De synkroniserede optagede tidsrum slettes hos os. For også at fjerne vores adgang skal du fjerne Vi finder lige en dag under forbundne apps i din konto hos %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove this account? Its synced busy times are deleted on our side. To also revoke our access, remove We'll find a day in that account's connected-apps settings at %@."
          }
        }
      }
    },
