    "group.whatMembersSeeBody": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle i en gruppe kan se hinandens navne, og hvornår de er optaget, og om en kalender ikke er opdateret i flere dage. Ingen kan se din e-mailadresse, navnene på dine kalendere eller hvad dine aftaler hedder. Vi gemmer slet ikke titler på aftaler i dine kalendere."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everyone in a group can see each other's name, when they are busy, and whether a calendar hasn't been updated for days. Nobody sees your email address, your calendars' names, or what any of your events are called. We never store the titles of events in your calendars at all."
          }
        }
      }
    },
