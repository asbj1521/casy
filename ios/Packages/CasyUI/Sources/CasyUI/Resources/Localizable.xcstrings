    "primaryCalendar.noneOption": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen (vi lægger intet i dine kalendere)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "None (we add nothing to your calendars)"
          }
        }
      }
    },
    "primaryCalendar.confirmChange": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gør %1$@ til din primære kalender? Nye aftaler lægges i %1$@. Aftaler, der allerede er lagt i %2$@, bliver, hvor de er."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make %1$@ your primary calendar? New events go into %1$@. Events already added to %2$@ stay where they are."
          }
        }
      }
    },
    "primaryCalendar.confirmClear": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop med at bruge %@ som primær kalender? Så lægger vi ingen aftaler i dine kalendere. Aftaler, der allerede er lagt der, bliver."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop using %@ as your primary calendar? We then add no events to your calendars. Events already added stay."
          }
        }
      }
    },
    "primaryCalendar.yesChange": {
      "extractionState": "manual",
