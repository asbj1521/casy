    "aiConsent.footnote": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slået til sender vi det, du skriver eller siger til AI'en, det, du planlægger, navnene på dine kalendere og titlerne på dine aftaler til Anthropic, som laver AI-modellen Claude, så vi kan planlægge med dig, sortere dine kalendere og vurdere, hvad dine aftaler betyder for dig. For fly, tog og busser følger stedet med, så vi kan finde dine rejser. Vi deler også, uden titler, hvornår noget vigtigt starter, så datoer kan rangeres for gruppen. Du kan slå det fra når som helst. Læs mere i %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When it is on, we send what you write or say to the AI, what you plan, the names of your calendars and the titles of your events to Anthropic, which makes the AI model Claude, so we can plan with you, sort your calendars and judge what your events mean for you. For flights, trains and buses the place goes too, so we can find your trips. We also share, without titles, when something important starts, so dates can be ranked for the group. You can turn it off at any time. Read more in the %@."
          }
        }
      }
    },
    "aiConsent.privacyLink": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
