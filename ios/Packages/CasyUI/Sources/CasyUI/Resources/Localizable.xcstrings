    "admin.correctionsTitle": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Rettelser til AI'en"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrections of the AI"
          }
        }
      }
    },
    "admin.correctionsIntro": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det, folk har sendt, når AI'en tog fejl: aftalens titel, hvad AI'en sagde, hvad de skrev, og hvad der kom ud af det. Aldrig hvem. Gør et gentaget fejlskøn til en skarpere regel og en ny, opfundet testsag, og markér rettelsen som håndteret, så den slettes."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What people sent when the AI got it wrong: the event's title, what the AI said, what they wrote, and what came of it. Never who. Turn a repeated mistake into a sharper rule and a new, made-up test case, then mark the correction handled and it is deleted."
          }
        }
      }
    },
    "admin.correctionsNone": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen rettelser endnu."
