    "blocked.footnote": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Folk, du har blokeret, kan ikke invitere dig til grupper. De får ikke at vide, at du har blokeret dem."
          }
        },
