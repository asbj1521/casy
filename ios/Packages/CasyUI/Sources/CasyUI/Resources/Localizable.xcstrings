    "trips.returnIntro": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi kan se, at du rejser ud, men ikke hvornår du kommer hjem. Måske kører du hjem, eller hjemrejsen står ikke i din kalender."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We can see you travel out, but not when you come back. Maybe you drive home, or the way back isn't in your calendar."
